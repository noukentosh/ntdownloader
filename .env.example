# File manager (required for /api/file-manager)
FILE_MANAGER_USER=
FILE_MANAGER_PASSWORD=
# Random secret for signing session cookies (e.g. openssl rand -hex 32)
FILE_MANAGER_SECRET=

# Optional: uploads directory (default: ./uploads relative to process cwd)
# UPLOADS_ROOT=uploads

# Optional limits
# FILE_MANAGER_MAX_UPLOAD_BYTES=52428800
# FILE_MANAGER_MAX_FETCH_BYTES=52428800

# TTL (seconds) for signed direct download links (curl/wget); max 604800 (7 days)
# FILE_MANAGER_DOWNLOAD_LINK_TTL_SEC=3600

# Bun HTTP body limit (multipart uploads). Raise if browser shows ERR_CONNECTION_ABORTED.
# Default in code: max(FILE_MANAGER_MAX_UPLOAD_BYTES + 48MB, 132MB).
# BUN_MAX_REQUEST_BODY_BYTES=536870912
